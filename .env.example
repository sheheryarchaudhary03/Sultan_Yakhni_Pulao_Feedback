# Copy to .env for local use. On Vercel, set these under Settings → Environment Variables.

# PostgreSQL 13+. On Vercel, connecting a Neon database fills these in for you.
DATABASE_URL=postgresql://user:password@localhost:5432/sultan_feedback
# Optional: direct (non-pooled) URL, used only for migrations.
DATABASE_URL_UNPOOLED=

# First admin account, created on first start if no admin exists yet.
# Change the password from the admin portal straight after signing in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Optional: long random string. Derived from DATABASE_URL when empty.
SECRET_KEY=

# Set to false only for local http:// testing.
COOKIE_SECURE=true
SESSION_HOURS=12
APP_TIMEZONE=Asia/Karachi
DB_POOL_MAX=5
